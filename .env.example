# ==============================================================================
# DARK MATTER — ELITE FITNESS
# Environment Configuration Template (.env.example)
# Duplicate this file as .env and configure your credentials.
# NEVER commit the real .env file with production credentials to public version control.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=production
APP_DEBUG=false
APP_NAME="DARK MATTER — Elite Fitness"
APP_URL=https://darkmatter-fitness.com

# Database Configuration (MySQL 8+)
# Supports standard discrete variables OR cloud connection string (DATABASE_URL / MYSQL_URL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitness_gym
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SSL / TLS Encrypted MySQL Connection (For Managed MySQL Providers like Aiven, AWS RDS, PlanetScale)
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# DB_SSL_VERIFY_SERVER_CERT=true
# DATABASE_URL=mysql://user:password@host.aivencloud.com:12345/fitness_gym?ssl-mode=REQUIRED

# Storage Driver (local | s3)
# 'local' uses the local filesystem or mounted persistent cloud disk (e.g. Render Disk at /var/www/html/uploads)
# 's3' connects directly to Cloudflare R2, AWS S3, or DigitalOcean Spaces
STORAGE_DRIVER=local

# S3-Compatible Cloud Object Storage (Only required if STORAGE_DRIVER=s3)
# S3_BUCKET=darkmatter-assets
# S3_REGION=auto
# S3_KEY=your_access_key_id
# S3_SECRET=your_secret_access_key
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.darkmatter-fitness.com

# Initial Administrator Provisioning (Automated zero-touch migration)
ADMIN_INIT_USERNAME=darkmatter_admin
ADMIN_INIT_EMAIL=admin@darkmatter-fitness.com
ADMIN_INIT_PASSWORD=ChangeThisSecurePassword!2026

# Security & Throttling
SESSION_SECRET=change_this_to_a_random_secure_64_char_hex_token
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=300
HONEYPOT_FIELD=dm_telemetry_check
