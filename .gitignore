# ==============================================================================
# Fitness Gym - Git Ignore Rules
# ==============================================================================

# 1. Environment & Sensitive Credentials
.env
.env.example
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt

# 2. Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
*~
.directory

# 3. Editor & IDE Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 4. Logs & Debugging
*.log
error_log
php_errors.log
logs/
.system_generated/

# 5. Scratch & Temporary Development Scripts
scratch/
*.tmp
*.temp

# 6. Database Backups & Large Archives
backups/*
!backups/.htaccess
*.sql.gz
*.sql.bak
*.sql.tar
database/*.sql.gz
database/*.sql.bak

# 7. User Uploads
uploads/gallery/*
!uploads/gallery/index.html
uploads/trainers/*
!uploads/trainers/index.html

# 8. Dependency Managers
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 9. Docker Local Overrides
docker-compose.override.yml
